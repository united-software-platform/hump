# Agent image
SDD_KIT_IMAGE=ghcr.io/united-software-platform/sdd-developer-kit
SDD_KIT_IMAGE_TAG=latest

# Application
PROJECT_DIR=/app
CLAUDE_CONFIG_DIR=/home/claude/.claude
CLAUDE_ACCOUNTS_DIR=.claude-accounts
CONTAINER_SSH_DIR=/home/claude/.ssh
SSH_DIR=.ssh
SSH_KEY=.ssh/id_ed25519
SSH_CONFIG=.ssh/config
SSH_KNOWN_HOSTS=.ssh/known_hosts
GIT_HOST=как
GIT_USER=git
USER_ID=1000
GROUP_ID=1000
GH_TOKEN=ghp_xxxxxxxx

AGENT_RUNNER_PORT=11900
AGENT_RUNNER_URL=http://host.docker.internal:11900
AGENT_RUNNER_TOKEN=

# LiteLLM gateway
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm
LITELLM_IMAGE_TAG=latest
LITELLM_PORT=4000
# Ключ доступа к самому шлюзу: обязан начинаться с sk-, задаётся произвольной длинной строкой
LITELLM_MASTER_KEY=sk-
# Шифрует ключи провайдеров, когда шлюз хранит их в БД
LITELLM_SALT_KEY=

# Хранилище состояния шлюза: выданные ключи и записи об обращениях.
# Значения трёх переменных ниже и содержимое DATABASE_URL описывают одну и ту же базу —
# при правке менять надо оба места, иначе шлюз не пройдёт авторизацию в базе при старте.
POSTGRES_IMAGE=postgres
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_USER=litellm
POSTGRES_PASSWORD=
POSTGRES_DB=litellm
# Строка подключения шлюза к базе: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>.
# Хост postgres — имя сервиса из docker-compose.hump.yml, а не адрес хоста.
DATABASE_URL=postgresql://litellm:@postgres:5432/litellm

# Вход в административную панель шлюза (/ui). Пока переменные пусты, действует вход admin
# с паролем, равным LITELLM_MASTER_KEY: панель тогда открывается ключом уровня API,
# и её компрометация равна компрометации всего шлюза.
UI_USERNAME=admin
UI_PASSWORD=
OLLAMA_IMAGE=ollama/ollama
OLLAMA_IMAGE_TAG=latest
# Адрес Ollama для локального маршрута. Умолчание указывает на сервис ollama из
# docker-compose.hump.yml; для Ollama на хосте — http://host.docker.internal:11434
OLLAMA_API_BASE=http://ollama:11434
# Облачный маршрут hump-cloud из config/litellm.yaml: сервис с Anthropic-совместимым API.
# Для api.anthropic.com базовый URL можно не задавать — он подставляется провайдером.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=

