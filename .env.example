# Agent image
SDD_KIT_IMAGE=ghcr.io/united-software-platform/sdd-developer-kit
SDD_KIT_IMAGE_TAG=latest

# Application
PROJECT_DIR=/app
CLAUDE_CONFIG_DIR=/home/claude/.claude
CLAUDE_ACCOUNTS_DIR=.claude-accounts
CONTAINER_SSH_DIR=/home/claude/.ssh
SSH_DIR=.ssh
SSH_KEY=.ssh/id_ed25519
SSH_CONFIG=.ssh/config
SSH_KNOWN_HOSTS=.ssh/known_hosts
GIT_HOST=как
GIT_USER=git
USER_ID=1000
GROUP_ID=1000
GH_TOKEN=ghp_xxxxxxxx

AGENT_RUNNER_PORT=11900
AGENT_RUNNER_URL=http://host.docker.internal:11900
AGENT_RUNNER_TOKEN=

# LiteLLM gateway
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm
LITELLM_IMAGE_TAG=latest
LITELLM_PORT=4000
# Административный ключ шлюза: обязан начинаться с sk-, задаётся произвольной длинной строкой
LITELLM_MASTER_KEY=sk-
# Шифрует ключи провайдеров, когда шлюз хранит их в базе
LITELLM_SALT_KEY=

# Образ и тег базы, в которой шлюз хранит своё состояние
POSTGRES_IMAGE=postgres
POSTGRES_IMAGE_TAG=17-alpine
# Имя пользователя, пароль и имя базы
POSTGRES_USER=litellm
POSTGRES_PASSWORD=
POSTGRES_DB=litellm
# Строка подключения шлюза к той же базе: пароль и имя базы совпадают с POSTGRES_* выше,
# postgres — имя сервиса из docker-compose.hump.yml, а не адрес хоста
DATABASE_URL=postgresql://litellm:@postgres:5432/litellm

# Вход в панель шлюза (/ui); пока пусты, действует admin с паролем LITELLM_MASTER_KEY
UI_USERNAME=admin
UI_PASSWORD=

# Образ и тег сервера локальных моделей
OLLAMA_IMAGE=ollama/ollama
OLLAMA_IMAGE_TAG=latest
# Адрес сервера моделей для локального маршрута; для Ollama на хосте — http://host.docker.internal:11434
OLLAMA_API_BASE=http://ollama:11434
# Адрес и ключ облачного маршрута hump-cloud: любой сервис с Anthropic-совместимым API
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=

